@model IEnumerable<CategoryVM>

<style>
    .stack-table {
        max-width: 900px;
        margin: 0 auto;
    }

    @Model (max-width: 768px) {
        .stack-table thead

    {
        display: none;
    }

    .stack-table tr {
        display: block;
        margin-bottom: 15px;
        border: 1px solid #444;
        padding: 10px;
        background-color: #2c3338;
    }

    .stack-table td {
        display: block;
        text-align: right;
        padding-left: 50%;
        position: relative;
        color: #fff;
    }

        .stack-table td::before {
            content: attr(data-label);
            position: absolute;
            left: 10px;
            font-weight: bold;
            text-align: left;
            color: #9aa0a6;
        }

    }
</style>

<div style="max-width:900px; margin:0 auto 15px auto; text-align:right;">
    <a asp-action="Create"
       class="btn btn-success">
        + Create Category
    </a>
</div>


<table class="table table-bordered stack-table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Created Date</th>
            <th>Operations</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td data-label="Name">@item.Name</td>
                <td data-label="Created Date">
                    @item.CreatedDate.ToString("MM/dd/yyyy")
                </td>
                <td data-label="Operations">
                    <a asp-action="Update" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Update</a>
                    <a asp-action="Detail" asp-route-id="@item.Id" class="btn btn-sm btn-check">Info</a>
                    <form asp-action="Delete"
                          asp-route-id="@item.Id"
                          method="post"
                          style="display:inline;">
                        <button type="submit" class="btn btn-sm btn-danger">
                            Delete
                        </button>
                    </form>

                </td>
            </tr>
        }
    </tbody>
</table>
